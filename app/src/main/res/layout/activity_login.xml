<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Curved Header with Entrance Animation Target -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@drawable/bg_header_signin"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <!-- Logo -->
            <ImageView
                android:id="@+id/imgAppLogo"
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:background="@drawable/bg_edittext"
                android:padding="6dp"
                android:src="@drawable/logo" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BakeDrop"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MERCHANT PORTAL"
                android:textColor="#E0F2FE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"/>
        </LinearLayout>

        <!-- Form Card Container -->
        <LinearLayout
            android:id="@+id/formCardLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Segmented Switcher Tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_edittext"
                android:weightSum="2"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tvSignIn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Sign In"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:background="@drawable/bg_tab_signin"/>

                <TextView
                    android:id="@+id/tvSignUp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Sign Up"
                    android:textColor="#38B6FF"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Full Name (Sign Up only) -->
            <TextView
                android:id="@+id/lblFullName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FULL NAME"
                android:textColor="#38B6FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginTop="20dp"
                android:visibility="gone"/>

            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_edittext"
                android:hint="e.g. John Doe"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="6dp"
                android:visibility="gone"/>

            <!-- Email -->
            <TextView
                android:id="@+id/lblEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMAIL ADDRESS"
                android:textColor="#38B6FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginTop="16dp"/>

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_edittext"
                android:hint="merchant@bakedrop.com"
                android:inputType="textEmailAddress"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="6dp"/>

            <!-- Password -->
            <TextView
                android:id="@+id/lblPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PASSWORD"
                android:textColor="#38B6FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginTop="16dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_edittext"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:paddingHorizontal="16dp"/>

                <ImageView
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="12dp"
                    android:src="@android:drawable/ic_menu_view"
                    app:tint="@color/text_slate_500" />
            </RelativeLayout>

            <!-- Forgot Password -->
            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forgot password?"
                android:textColor="#073578"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"/>

            <!-- Action Button -->
            <Button
                android:id="@+id/btnAction"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Sign In"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#38B6FF"
                android:layout_marginTop="18dp"/>

            <!-- OR Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1.2dp"
                    android:layout_weight="1"
                    android:background="#E2E8F0"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OR"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="14dp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1.2dp"
                    android:layout_weight="1"
                    android:background="#E2E8F0"/>
            </LinearLayout>

            <!-- Official Google Sign-In Button with Multi-color Logo -->
            <LinearLayout
                android:id="@+id/btnGoogleSignIn"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_google_btn"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_google"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Continue with Google"
                    android:textColor="#3C4043"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Terms & Privacy Policy Note -->
            <TextView
                android:id="@+id/tvTermsPolicy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="By continuing, you agree to BakeDrop Terms of Service &amp; Privacy Policy."
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="18dp"
                android:visibility="gone"/>

            <!-- Footer Badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 SECURED BY BAKEDROP.DELIVERY"
                android:textColor="@color/text_slate_500"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_gravity="center"
                android:layout_marginTop="22dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>